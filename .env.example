# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Locally:
#   node --env-file=.env src/sources/unleashed.js Products
#
# On the Pi the systemd unit reads /home/trevor/rachels-turk/.env, so put a
# copy there too. Deploys and rollbacks never touch it — which also means a
# rollback will not restore it, so keep it somewhere safe.

# Unleashed — https://au.unleashedsoftware.com → Integration → Unleashed API Access
UNLEASHED_API_ID=
UNLEASHED_API_KEY=
